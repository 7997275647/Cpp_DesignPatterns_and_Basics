# Doxygen Configuration File
# Generated for C++ Design Patterns and Basics Project

PROJECT_NAME = "C++ Design Patterns and Basics"
PROJECT_NUMBER = 1.0
PROJECT_BRIEF = "A comprehensive guide to C++ design patterns, basics, and best practices"

# Input settings
INPUT = Basics/Inc \
         Basics/Src \
         DesignPatterns/Inc \
         DesignPatterns/Src \
         Application/Inc \
         Application/Src

# File patterns to include
FILE_PATTERNS = *.hpp \
                *.cpp \
                *.h \
                *.cc

# Recursive input directories
RECURSIVE = YES

# Output directory for generated files
OUTPUT_DIRECTORY = ./docs/doxygen

# Generate XML output for Breathe
GENERATE_XML = YES
XML_OUTPUT = xml

# Don't generate other formats (we only need XML for Breathe)
GENERATE_HTML = NO
GENERATE_LATEX = NO
GENERATE_MAN = NO

# Documentation settings
EXTRACT_ALL = YES
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
EXTRACT_LOCAL_CLASSES = YES

# Enable C++ mode
OPTIMIZE_OUTPUT_FOR_C = NO

# Include code snippets
SOURCE_BROWSER = YES
INLINE_SOURCES = YES

# Search settings
SEARCHENGINE = NO

# Doxygen settings
QUIET = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = NO

# Additional options
CLANG_ASSISTED_PARSING = YES
CLANG_OPTIONS = -std=c++17

# Tab size
TAB_SIZE = 4
